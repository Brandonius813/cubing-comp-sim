# Public browser configuration. Guest/offline functionality requires no values.
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=
# Optional consent-gated product analytics. Never put private tokens here.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional, separately consent-gated diagnostics. This is a public ingestion DSN.
VITE_SENTRY_DSN=
# production/development default to the build mode; use staging for a staging project.
VITE_SENTRY_ENVIRONMENT=
# Source-map upload tokens and provider admin/service keys belong only in CI/server secrets.
