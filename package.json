{
  "name": "cubing-comp-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/assert-engine.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "typecheck": "tsc -b",
    "engine:build": "node scripts/build-engine.mjs",
    "engine:verify": "node engine/scripts/reference.mjs 2 && node scripts/build-engine.mjs && node engine/scripts/conformance.mjs",
    "build:ui": "tsc -b && vite build",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@sentry/browser": "11.6.0",
    "@supabase/supabase-js": "2.103.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "$vite"
  }
}
