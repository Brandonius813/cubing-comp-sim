{
  "name": "cubing-comp-sim-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "prepare-engine": "node scripts/engine-bundle.mjs",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/engine/*.test.ts && node --test scripts/engine-bundle.test.mjs",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "eas-build-pre-install": "node scripts/engine-bundle.mjs"
  },
  "dependencies": {
    "expo": "57.0.30",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-keep-awake": "57.0.2",
    "expo-sqlite": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "expo-audio": "57.0.5",
    "expo-secure-store": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react-native-url-polyfill": "4.0.0",
    "@supabase/supabase-js": "2.117.3",
    "expo-asset": "57.0.20"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
