# Public frontend configuration only. Never put service-role keys, Apple
# signing keys, provider secrets or real user sessions into this file.
# Copy values from a reviewed staging environment into the private build env.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
EXPO_PUBLIC_API_URL=https://YOUR_STAGING_API_HOST
EXPO_PUBLIC_WEB_URL=https://YOUR_STAGING_WEB_HOST
# Leave blank until native callback/deletion acceptance is complete.
EXPO_PUBLIC_AUTH_PROVIDERS=
