# Server-only configuration. Do not copy this file into the website build.
PORT=3001
HOST=127.0.0.1
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RELEASE=development
LOG_LEVEL=info

# Public key verifies normal account/save requests.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-key
# Server-only admin key enables self-service identity deletion and retry cleanup.
# Never create a VITE_ variable for this key or include it in a browser build.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Use a dedicated database role. Hosted database connections must verify TLS.
DATABASE_URL=postgresql://ccs:replace-with-password@localhost:5432/ccs
DATABASE_TLS=false
# Optional path to a CA certificate when your database needs a custom CA.
# DATABASE_CA_FILE=/run/secrets/database-ca.pem

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=cubing-comp-sim-saves
R2_ACCESS_KEY_ID=replace-with-restricted-bucket-key
R2_SECRET_ACCESS_KEY=replace-with-restricted-bucket-secret
# Local S3-compatible testing can set this true.
R2_FORCE_PATH_STYLE=false
